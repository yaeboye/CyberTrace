# Python
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/
*.egg-info/

# Node
node_modules/
.next/
dist/
build/

# Data (traces can be large)
data/traces/*.npy
data/traces/*.csv
data/keys/*.bin
*.db

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# ESP32
esp32/.pio/
esp32/.vscode/

# report generator lives under report/build/ and must be tracked
!report/build/
!report/build/**

# Word lock/owner files
~$*
